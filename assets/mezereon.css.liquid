#mz-app {
  width: 100%;
}

  .mz-autocomplete a, #mz-app a {
    color: rgb(var(--color-foreground));
  }

.mz-facet .mz-active .mz-checkbox label {
  color: rgb(var(--color-foreground));
}

.mz-aggs-vertical, .mz-hits {
  padding: 0;
  position: relative;
}

.mz-aggs-vertical {
  padding-right: 5px;
}

.mz-autocomplete-list,
.mz-autocomplete-grid {
  width: 100%;
}

.mezereon .mz-results {
  transition: all 0.10s ease-in;
  opacity: 0;
  margin-bottom: 15px;
}

  .mezereon .mz-results.mz-loaded {
    opacity: 1;
  }

.mezereon .mz-grid {
  margin-top: 20px;
}

.mezereon .mz-grid-item {
  display: flex;
  width: 25%;
}

.mezereon .mz-filter-layout-vertical .mz-grid-item {
  width: 33%;
}

@media only screen and (max-width: 768px) {

  .mezereon .mz-filter-layout-vertical .mz-grid-item,
  .mezereon .mz-grid-item {
    width: 50%
  }
}

.mezereon .mz-facet label {
  font-size: 1em;
  text-transform: none;
}

.mezereon .mz-pull-right {
  margin-top: 20px;
}

.mezereon .ch-drawer {
  max-width: 450px;
}

.mezereon.toggle-over-flow {
  position: inherit;
}

.mezereon .mz-item-image-wrapper > a {
  display: contents;
}

.mezereon .mz-item-card:hover .qview-button-wrapper {
  visibility: visible;
  opacity: 1;
}


.mezereon .mz-search-revealed {
  opacity: 0;
}

.mezereon .mz-skeleton {
  display: inline-block;
  position: relative;
  overflow: hidden;
  background-color: #e4e4e4;
  border-radius: 5px;
}

  .mezereon .mz-skeleton:after {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    -webkit-transform: translateX(-100%);
    transform: translateX(-100%);
    background-image: -webkit-gradient(linear, left top, right top, color-stop(0, hsla(0, 0%, 100%, 0)), color-stop(20%, hsla(0, 0%, 100%, .2)), color-stop(60%, hsla(0, 0%, 100%, .5)), to(hsla(0, 0%, 100%, 0)));
    background-image: linear-gradient(90deg, hsla(0, 0%, 100%, 0), hsla(0, 0%, 100%, .2) 20%, hsla(0, 0%, 100%, .5) 60%, hsla(0, 0%, 100%, 0));
    -webkit-animation: mz-skeleton-animation 1.2s infinite;
    animation: mz-skeleton-animation 1.2s infinite;
    content: ""
  }

@-webkit-keyframes mz-skeleton-animation {
  to {
    -webkit-transform: translateX(100%);
    transform: translateX(100%)
  }
}

@keyframes mz-skeleton-animation {
  to {
    -webkit-transform: translateX(100%);
    transform: translateX(100%)
  }
}

.mezereon .mz-skeleton-wrapper.mz-selections {
  min-height: 60px;
}

.mezereon .mz-skeleton-wrapper .mz-grid-item {
  display: block !important;
}

@media only screen and (min-width: 768px) {
  .mezereon .mz-skeleton-wrapper.mz-aggs-horizontal.mz-hidden-xs.mz-refinements.mz-horizontal {
    display: flex !important;
  }
}

.mezereon div.mz-bar:empty,
.mezereon div.vue-slider-dot-handle:empty,
.mezereon div.mz-slider-veil:empty,
.mezereon div.mz-arrow:empty {
  display: block;
}

.mezereon div.mz-label {
  margin: 15px 0 10px 0;
  font-size: 16px;
}

.mezereon .mz-checkbox.star .state:after,
.mezereon .mz-checkbox.star .state:before {
  font-size: 20px;
  line-height: 1;
}

.mezereon .ch-drawer div:empty {
  display: block;
}

.mezereon .mz-paging-standard a:not([href]) {
  cursor: pointer;
}

.mz-show-more a {
  color: rgba(var(--color-foreground), 0.75);
  text-decoration: none;
}

.mz-hits-container {
  margin-top: 20px;
}

  .mz-hits-container .thumbnail {
    height: 100%;
    min-height: 400px;
    background-color: transparent;
  }

@media only screen and (max-width: 767px) {
  .mz-hits-container .thumbnail {
    min-height: 250px;
  }
}

.mz-selections {
  padding: 0;
  margin-top: 10px;
  gap: 5px;
}

.mz-selections-option,
.mz-clear-selections {
  background: transparent;
  border: 1px solid #bbb;
  padding: 0 10px;
  border-radius: 15px;
  margin: 0;
  color: rgba(var(--color-foreground), 0.75);
}

.mz-filter-layout-vertical .mz-selections-option,
.mz-filter-layout-vertical .mz-clear-selections {
  width: 100%;
}

.mz-filter-layout-vertical .mz-selection-name {
  flex-grow: 1;
}

.mz-filter-layout-vertical .mz-selections-remove {
  flex-grow: inherit;
}

.mz-selections-remove {
  padding: 0 5px 0 10px;
  border-left: none;
  margin-left: 0;
}

.mz-facet .mz-node:hover {
  background-color: #f4f4f4;
  color: rgba(var(--color-foreground), 0.75);
  border-radius: 8px;
}

.mz-aggs .mz-active {
  background-color: transparent;
}

.mz-selections-option:hover {
  text-decoration: none;
}

  .mz-selections-option:hover .mz-selections-name {
    text-decoration: line-through;
  }

.mz-facet .mz-active .mz-checkbox label {
  font-weight: 400;
}

.mz-box-body {
  padding: 0;
}

.mz-action-bar-group {
  display: flex;
  flex-wrap: wrap;
  margin-top: 5px;
}

  .mz-action-bar-group .mz-select select {
    padding: 10px 5px;
    background-color: transparent;
    border: 2px solid transparent;
    color: rgba(var(--color-foreground), 0.75);
  }

  .mz-action-bar-group .mz-select,
  .mz-action-bar-group .mz-paging {
    display: flex;
  }

@media only screen and (max-width: 767px) {
  .mz-action-bar-group .mz-select.sort,
  .mz-action-bar-group .mz-paging {
    width: 50%;
  }
}


.mz-action-bar-group .mz-hits-info {
  font-size: small;
  margin-left: auto;
  display: flex;
  align-items: center;
}

.mz-hits-info span {
  margin-right: 5px;
}

@media only screen and (max-width: 767px) {
  .mz-action-bar-group > .mz-filter-btn {
    flex: 1 1 100%;
  }

  #mz-app .mz-action-bar-group a.mz-btn.mz-btn-primary {
    width: 100%;
    font-size: 15px;
    display: flex;
    justify-content: center;
    align-items: center;
    color: #fff;
  }

  .mz-action-bar-group a.mz-btn.mz-btn-primary svg {
    font-size: 18px;
  }

  .mz-paging .mz-select.pg select {
    width: auto;
  }

  .mz-select select {
    font-size: 13px;
  }

  .mz-aggs .mz-hidden-xs {
    display: none;
  }

  .mz-selections {
    margin-bottom: 10px;
  }

  .mz-filter-layout-vertical .mz-selections-option,
  .mz-filter-layout-vertical .mz-clear-selections {
    width: auto;
  }
}

.mezereon .mz-aggs-horizontal div.mz-label {
  height: 42px;
  background-color: #e2e2e2;
  box-shadow: none;
  letter-spacing: 0px;
  font-weight: 600;
}

.mz-facet .mz-popper[data-show][data-popper-placement=bottom-start] ~ div.mz-label:after {
  background: transparent;
}

.mz-facet.mz-horizontal div.mz-label {
  border-radius: 8px;
  margin: 0;
  padding: 12px 20px;
}

.mz-facet .mz-popper[data-show][data-popper-placement=bottom-start] ~ div.mz-label {
  border-radius: 8px;
  margin: 0;
  padding: 12px 20px;
  border: none;
  box-shadow: none;
}

.mz-facet .mz-popper[data-show][data-popper-placement=top-start] ~ div.mz-label {
  border-radius: 8px;
  margin: 0;
  padding: 12px 20px;
  border: none;
  box-shadow: none;
}

.mz-values.mz-popper[data-show][data-popper-placement=bottom-start] {
  transform: translateY(50px) !important;
}

.mz-values.mz-popper[data-show][data-popper-placement=top-start] {
  transform: translateY(-54px) !important;
}

.mz-facet .mz-popper {
  min-width: 350px;
  background-color: #fff;
  border: 1px solid #f1f0ee;
  padding: 10px;
  border-radius: 8px;
  z-index: 99;
}

.mz-btn-default {
  border: 1px solid transparent;
  border-radius: 8px;
}

.mz-btn {
  border-radius: 8px;
}

  .mz-btn:hover {
    border: 1px solid transparent;
    box-shadow: none;
  }

#mz-app .mz-filter-layout-overlay .mz-filter-btn {
  display: inline-flex;
  margin-right: 5px;
}

  #mz-app .mz-filter-layout-overlay .mz-filter-btn a {
    color: white;
  }
