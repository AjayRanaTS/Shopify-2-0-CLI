{% style %}
    @media screen and (min-width: 750px) {
      .page-width {
          padding: 0 5rem 5rem 5rem!important;
      }
  }
      .top{
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        gap: 1rem;
      }
      .left-side{
        width: 60%;
            margin: 2rem 0rem;
      }
      h1{
        font-size: 70px !important;
       line-height: 6.5rem;
        font-weight: 700;
        margin: 3rem 0rem;
        color: white;
      }
      .right-side{
        width: 40%;
        display: flex;
        justify-content: center;
        align-items: center;
      }
      .right-inside{
        text-align: center;
        padding: 45px;
        width: 60%;
        border: 1px solid;
        border-radius: 10px;
      }
      hr{
        margin: 0;
        width: 85%;
        background: #1E10EA;
    }
      .mid{
        display: flex;
        align-items: center;
        gap: 1rem;
    }
      button{
        background: #1E10EA;
        border-radius: 15px;
        color: white;
        border: none;
            padding: 0px 15px;
      }
      h2{
        color: white;
        font-size: 20px;
        font-weight: 700;
      }
    h3{
      color: white;
          font-size: 25px;
    }
    .grid-item{
      width: 23%;
    }
{% endstyle %}
<div class="page-width">
  <div class="top">
    <div class="left-side">
      <h1>{{ section.settings.headin }}</h1>
      <p style="width: 84%;">{{ section.settings.para1 }}</p>
    </div>
    <div class="right-side">
      <div class="right-inside">
        <p style="margin-bottom: 0px;">{{ section.settings.date1 }}</p>
        <p style="margin-top: 0px;">{{ section.settings.city1 }}</p>
        <button>{{ section.settings['rs-btn'] }}</button>
      </div>
    </div>
  </div>
  <div class="mid">
    <h2>At-A-Glance</h2>
    <hr>
  </div>
  <div class="bot">
    <div class="grid">
      {%- for block in section.blocks -%}
        {% if block.settings['grid-txt'] != blank %}
          <div class="grid-item">
            <p>{{ block.settings['grid-txt'] }}</p>
          </div>
        {% endif %}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "new",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "headin",
      "label": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "para1",
      "label": "Text"
    },
    {
     "type": "inline_richtext",
      "id": "date1",
      "label": "Date"
    },
    {
     "type": "inline_richtext",
      "id": "city1",
      "label": "City"
    },
    {
     "type": "richtext",
      "id": "rs-btn",
      "label": "Button"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "block",
      "limit": 4,
      "settings": [
        {
          "type": "richtext",
          "id": "grid-txt",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "new"
    }
  ]
}
{% endschema %}
